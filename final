#include <iostream>
#include <vector>
#include <fstream>
#include <string>
using namespace std;

class QRGrid {
private:
    vector<vector<int>> grid;
    int size;

public:
    QRGrid(int n) : size(n) {
        grid.assign(size, vector<int>(size, 0));
    }

    void set(int r, int c, int val) {
        grid[r][c] = val;
    }

    int get(int r, int c) const {
        return grid[r][c];
    }

    int getSize() const {
        return size;
    }

    void display() const {
        for (int r = 0; r < size; r++) {
            for (int c = 0; c < size; c++) {
                cout << (grid[r][c] ? "██" : "  ");
            }
            cout << endl;
        }
    }

    void saveToFile(const string& filename) const {
        ofstream out(filename);
        for (int r = 0; r < size; r++) {
            for (int c = 0; c < size; c++) {
                out << grid[r][c];
            }
            out << "\n";
        }
        out.close();
    }
};


