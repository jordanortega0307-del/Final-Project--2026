string addSignature(const string& msg) {
    return msg + "|" + SIGNATURE;
}

string toBinary(const string& s) {
    string bin = "";
    for (char ch : s) {
        for (int i = 7; i >= 0; i--) {
            bin += ((ch >> i) & 1) ? '1' : '0';
        }
    }
    return bin;
}

// Simple checksum: sum of ASCII values
int checksum(const string& s) {
    int sum = 0;
    for (char ch : s) sum += int(ch);
    return sum % 256;
}

// Convert binary → QR grid
QRGrid encodeToGrid(const string& bin) {
    int n = 25; // fixed grid size
    QRGrid qr(n);

    int idx = 0;
    for (int r = 0; r < n; r++) {
        for (int c = 0; c < n; c++) {
            if (idx < bin.size()) {
                qr.set(r, c, bin[idx] == '1');
                idx++;
            }
        }
    }
    return qr;
}

void embedChecksum(QRGrid& qr, int cs) {
    for (int i = 0; i < 8; i++) {
        int bit = (cs >> (7 - i)) & 1;
        qr.set(0, i, bit);
    }
}

string extractBinary(const QRGrid& qr) {
    string bin = "";
    for (int r = 0; r < qr.getSize(); r++) {
        for (int c = 0; c < qr.getSize(); c++) {
            bin += qr.get(r, c) ? '1' : '0';
        }
    }
    return bin;
}

string binaryToText(const string& bin) {
    string out = "";
    for (int i = 0; i + 7 < bin.size(); i += 8) {
        int val = 0;
        for (int b = 0; b < 8; b++) {
            val = val * 2 + (bin[i + b] - '1' + 1);
        }
        out += char(val);
    }
    return out;
}

// Decode entire QR grid
string decodeGrid(const QRGrid& qr) {
    string bin = extractBinary(qr);
    return binaryToText(bin);
}

